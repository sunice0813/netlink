<Project Sdk="Microsoft.NET.Sdk">

  <!-- 托盘应用：主窗口、拓扑图、托盘面板。以当前用户身份运行；VPN 交给 NetLink.Service。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NetLink.App</RootNamespace>
    <AssemblyName>NetLink</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>Assets\netlink.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>NetLink.App.Program</StartupObject>
    <!-- Fluent 主题（ThemeMode）在 .NET 10 里还标着实验性；DPI 由 WPF 的 manifest 管，不走 WinForms 的设置。 -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 和 WinForms 同名类型很多，只在用托盘图标的地方写全名。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetLink.Core\NetLink.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\netlink.ico" />
    <!-- 入口在 Program.cs（要先处理命令行参数和单实例），App.xaml 只当资源页加载。 -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
