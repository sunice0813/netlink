<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 服务（SYSTEM 身份）：只负责用安装目录里的 openconnect 连、断公司 VPN。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NetLink.Service</RootNamespace>
    <AssemblyName>NetLink.Service</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetLink.Core\NetLink.Core.csproj" />
  </ItemGroup>

</Project>
